# Sociotix server configuration. Copy to .env.local (git-ignored) and fill in.
# Never commit real values. Placeholders only.

# development | test | preview | production — required when NODE_ENV=production.
APP_ENV=development

# Public origin used in email links. Must be https outside local development.
APP_URL=http://localhost:3000

# PostgreSQL connection URL. Leave empty to run only the public site
# (private areas then show "sign-in unavailable").
# Local example shape: postgresql://<user>:<password>@localhost:5433/socivanta_dev
# Outside localhost the URL must include sslmode=require (or verify-full).
DATABASE_URL=

# Connections per process (1–50).
DATABASE_POOL_MAX=10

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Authentication (Phase 5B) ----------------------------------------------
# Generate both with:  npm run auth:secrets   (32+ random bytes each, base64; must differ)
# Required in preview/production. Without them sign-in fails closed.
AUTH_SECRET=
DATA_ENCRYPTION_KEY=

# Email: capture (development/test only — saved to .local/mail, view at /dev/mailbox),
# resend or postmark (production; needs EMAIL_FROM and EMAIL_API_KEY).
EMAIL_TRANSPORT=capture
EMAIL_FROM=
EMAIL_API_KEY=
# Optional update emails (welcome, support replies, order updates). Verification, password
# and security emails are always sent; these stay off until set to true.
EMAIL_NOTIFICATIONS=false

# Show the illustrative demo dashboard/admin records to signed-in users.
# Refused in production. Real accounts never receive demo balances or orders.
DEMO_MODE=false

# Only set true behind a proxy you control that sets x-forwarded-for (used for per-IP rate limits).
TRUST_PROXY_HEADERS=false

# Integration tests start a throwaway embedded PostgreSQL automatically.
# To use your own server instead, set a URL whose database name contains "test".
# TEST_DATABASE_URL=

# ── Sociotix AI (Content Studio) ─────────────────────────────────────────
# Generation stays off unless EVERY setting below is in place AND the live
# provider test (npm run ai:verify) has passed and AI_GENERATION_ENABLED=true.
# anthropic is the only built adapter. The key is server-only.
AI_PROVIDER=none
AI_API_KEY=
# Built-in prices: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5.
# Any other model also needs AI_PRICE_INPUT_PER_MTOK and AI_PRICE_OUTPUT_PER_MTOK (USD per million tokens).
AI_MODEL=claude-opus-5-5
# Platform-wide spend per UTC day in micro-dollars (1,000,000 = $1). 0 = no spending.
AI_DAILY_BUDGET_MICROS=0
# Per provider call.
AI_TIMEOUT_MS=20000
AI_ANONYMOUS_ENABLED=false
# Launch switch: turn on only after `npm run ai:verify` passes.
AI_GENERATION_ENABLED=false
# Optional per-tool daily allowances for signed-in customers (defaults live in the tool registry).
# e.g. AI_DAILY_ALLOWANCES=order-explanation=20,support-assistant=15
AI_DAILY_ALLOWANCES=
# Optional monitored inbox the AI Support Assistant may offer when a person is needed.
# Leave blank until someone reads it: the assistant then says no contact channel is connected.
SUPPORT_CONTACT_EMAIL=

# --- Social account connections (AI-06) -------------------------------------
# Read-only OAuth links to customers' own social accounts. A platform can be
# connected only when it is listed here AND its client id and secret are set.
# List a platform only after its app review/approval is complete. Register
# this exact redirect URI with each platform: <APP_URL>/api/social/callback/<platform>
# e.g. SOCIAL_PROVIDERS_ENABLED=youtube,x
SOCIAL_PROVIDERS_ENABLED=
SOCIAL_INSTAGRAM_CLIENT_ID=
SOCIAL_INSTAGRAM_CLIENT_SECRET=
SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_SECRET=
SOCIAL_TIKTOK_CLIENT_ID=
SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_YOUTUBE_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_SECRET=
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
# AI-07: platforms allowed to PUBLISH (separate from connecting). Leave blank until a
# platform's posting permission is approved and a live test account is verified.
SOCIAL_PUBLISHING_ENABLED=
