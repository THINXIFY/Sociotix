# Sociotix STAGING environment (OPS-01B template). Placeholders only: never commit real values.
# On the server: /etc/sociotix/sociotix.env (owner root, group sociotix, mode 0640), or the host's secret store.
# Every value in <angle brackets> must be replaced. tests/unit/staging-env.test.ts checks this file
# against the app's configuration rules.

NODE_ENV=production
# "preview" = staging: same https/TLS/secret/proxy rules as production, separate everything.
APP_ENV=preview
APP_URL=https://<staging domain>

# Managed PostgreSQL 18, UTF-8, TLS. A separate database from production.
DATABASE_URL=postgresql://<app user>:<password>@<db host>:5432/<staging db>?sslmode=verify-full
# Connections per process. Budget: web instances x this + 5 per worker < the plan's connection limit.
DATABASE_POOL_MAX=10
LOG_LEVEL=info

# Generate with `npm run auth:secrets`. Must differ, and must differ from production's.
AUTH_SECRET=<generated>
DATA_ENCRYPTION_KEY=<generated>

# Transactional email from a staging sender (verified SPF/DKIM/DMARC).
EMAIL_TRANSPORT=<resend or postmark>
EMAIL_FROM=Sociotix Staging <no-reply@<staging mail domain>>
EMAIL_API_KEY=<provider key>
EMAIL_NOTIFICATIONS=false
SUPPORT_CONTACT_EMAIL=<support address>

# Client IPs (SEC-02). Must match the topology; see docs/deployment/STAGING_RUNBOOK.md.
# Reference topology (deploy/nginx/sociotix.conf, nginx overwrites X-Forwarded-For): hops 1, no header.
TRUST_PROXY_HEADERS=true
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=1

DEMO_MODE=false

# Postponed integrations: keep exactly as below.
AI_PROVIDER=none
AI_GENERATION_ENABLED=false
AI_ANONYMOUS_ENABLED=false
PAYMENTS_BANK_ENABLED=false
SOCIAL_PROVIDERS_ENABLED=
SOCIAL_PUBLISHING_ENABLED=
